{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNTS", "class_name": "RelayAccount" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayAccount"] }],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "ratelimits": [
    {
      "name": "EDGE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 1200, "period": 60 }
    },
    {
      "name": "ENROLL_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "env": {
    "staging": {
      "workers_dev": true,
      "durable_objects": {
        "bindings": [{ "name": "ACCOUNTS", "class_name": "RelayAccount" }]
      },
      "ratelimits": [
        {
          "name": "EDGE_LIMIT",
          "namespace_id": "1101",
          "simple": { "limit": 1200, "period": 60 }
        },
        {
          "name": "ENROLL_LIMIT",
          "namespace_id": "1102",
          "simple": { "limit": 30, "period": 60 }
        }
      ]
    }
  }
}
