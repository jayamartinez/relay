{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "durable_objects": { "bindings": [{ "name": "ACCOUNTS", "class_name": "RelayAccount" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayAccount"] }],
  "observability": { "enabled": false },
  "ratelimits": [
    { "name": "EDGE_LIMIT", "namespace_id": "1001", "simple": { "limit": 1200, "period": 60 } },
    { "name": "ENROLL_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ]
}
