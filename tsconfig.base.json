{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@relay/shared": ["packages/shared/src/index.ts"],
      "@relay/protocol": ["packages/protocol/src/index.ts"],
      "@relay/crypto": ["packages/crypto/src/index.ts"]
    }
  }
}
