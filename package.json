{
  "name": "relay",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm build:extension:dev && pnpm dev:server",
    "dev:extension": "node scripts/build-extension.mjs --dev --watch",
    "dev:server": "pnpm --filter @relay/server dev",
    "dev:server:lan": "pnpm --filter @relay/server dev:lan",
    "test:e2e": "node scripts/build-extension.mjs --dev --diagnostics && playwright test",
    "test:google": "node scripts/build-extension.mjs --dev --diagnostics && playwright test --config playwright.google.config.ts",
    "build:extension:dev": "node scripts/build-extension.mjs --dev",
    "build:extension:staging": "node scripts/build-extension.mjs --channel=staging",
    "build:extension:production": "node scripts/build-extension.mjs --channel=production",
    "build": "pnpm build:extension:production && pnpm --filter @relay/server build && node scripts/audit-build.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/server/tsconfig.json",
    "test": "vitest run --config vitest.config.ts && pnpm --filter @relay/server test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@playwright/test": "1.62.1",
    "@types/chrome": "0.2.8",
    "@types/node": "22.19.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.4",
    "typescript": "5.9.3",
    "vitest": "~4.1.0"
  }
}
